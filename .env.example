PRESALE_PROGRAM_ID=6t8hLg3DvTYzXkm3gfNhMfgqh2x1akjjM2zwv8SMprA3
PRESALE_TOKEN_MINT=8PydPRxUmKE88V2kurQyMCA33V1Ny4QBgSPrxNQsdQip
PRESALE_PRICE_PER_TOKEN=1000
PRESALE_ADMIN_WALLET=
REGISTRATION_FEE_SOL=0.025
LOGIN_FEE_SOL=0.002
TOKEN_PRICE_IDR=2
IDR_PER_SOL=16000
PRESALE_MIN_TOKENS=100
PRESALE_MAX_TOKENS=10000
PRESALE_START=2026-08-01T00:00:00Z
PRESALE_END=2027-03-31T23:59:59Z
RPC_RATE_LIMIT_PER_MINUTE=120
ADMIN_PATH=change-me

# PINDEX Signal membership (SOL, into collection wallet)
MEMBER_WEEKLY_FEE_SOL=0.05
MEMBER_MONTHLY_FEE_SOL=0.15

# DexScreener outbound rate budget (per-endpoint + global double safety)
DEX_REST_RATE_PER_MIN=60
DEX_GLOBAL_RATE_PER_MIN=55
DEX_INGESTION_RESERVATION_PER_MIN=20
DEX_CACHE_TTL_MS=15000

# Telegram alert bot
TELEGRAM_BOT_TOKEN=
