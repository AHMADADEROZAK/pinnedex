NEXT_PUBLIC_SOLANA_NETWORK=devnet
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

MONGODB_URI=mongodb://USER:PASS@localhost:27017/pin-dex?authSource=admin
SESSION_SECRET=generate-with-openssl-rand-base64-32
RATE_LIMIT_PER_MINUTE=5
EXCHANGE_RATE_API_KEY=
ADMIN_EMAILS=admin@example.com

PRESALE_COLLECTION_WALLET=
REGISTRATION_FEE_SOL=0.025
LOGIN_FEE_SOL=0.002
TOKEN_PRICE_IDR=2
IDR_PER_SOL=16000
PRESALE_MIN_TOKENS=100
PRESALE_MAX_TOKENS=10000
PRESALE_START=2026-08-01T00:00:00Z
PRESALE_END=2027-03-31T23:59:59Z
RPC_RATE_LIMIT_PER_MINUTE=120
ADMIN_PATH=change-me

# PINDEX Signal membership (SOL, into collection wallet)
MEMBER_WEEKLY_FEE_SOL=0.05
MEMBER_MONTHLY_FEE_SOL=0.15

# DexScreener outbound rate budget (per-endpoint + global double safety)
DEX_REST_RATE_PER_MIN=60
DEX_GLOBAL_RATE_PER_MIN=55
DEX_INGESTION_RESERVATION_PER_MIN=20
DEX_CACHE_TTL_MS=15000

# Telegram alert bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CONNECT_FEE_SOL=0.025
TELEGRAM_PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=

# Telegram party bot (Pine Room join OTP - separate from the alert bot)
TELEGRAM_PARTY_BOT_TOKEN=
TELEGRAM_PARTY_BOT_USERNAME=
TELEGRAM_PARTY_WEBHOOK_SECRET=

# Community
COMMUNITY_FEE_SOL=0.00025

# Minio S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pinnedex
MINIO_USE_SSL=false
# Public endpoint for presigned URLs (browser-reachable, e.g. https://s3.example.com).
# If unset, presigned URLs use MINIO_ENDPOINT (Docker hostname) and break in the browser.
MINIO_PUBLIC_URL=
