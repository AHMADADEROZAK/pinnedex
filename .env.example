# Solana network: devnet | testnet | mainnet-beta (accepts "mainnet" too)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

MONGODB_URI=mongodb://USER:PASS@localhost:27017/pin-dex?authSource=admin
SESSION_SECRET=generate-with-openssl-rand-base64-32
RATE_LIMIT_PER_MINUTE=5
EXCHANGE_RATE_API_KEY=
ADMIN_EMAILS=admin@example.com

# Semua fee user (register, login, community post, telegram connect, membership)
# masuk ke wallet ini.
PRESALE_COLLECTION_WALLET=
